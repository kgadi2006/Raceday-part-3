@model List<RaceDay.Mvc.Models.Result>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-5 mb-5">

    <h2 class="fw-bold">My Race Results</h2>

    <p class="text-muted">
        View your race finishing times and positions.
    </p>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Enrolment ID</th>
                        <th>Finish Time</th>
                        <th>Finishing Position</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.ResultID</td>
                            <td>@result.EnrolmentID</td>
                            <td>@result.FinishTime</td>
                            <td>@result.FinishingPosition</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No race results are available yet.
        </div>
    }

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>

</div>