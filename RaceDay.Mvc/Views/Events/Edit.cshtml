@model RaceDay.Mvc.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-5">
    <h2>Edit Event</h2>
    <p>Update the details of your event below.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form asp-controller="Events" asp-action="Edit"
          asp-route-id="@Model.EventID" method="post">

        <input type="hidden" asp-for="EventID" />

        <div class="mb-3">
            <label asp-for="EventTypeID" class="form-label">Event Type ID</label>
            <input asp-for="EventTypeID" class="form-control" type="number" required />
        </div>

        <div class="mb-3">
            <label asp-for="EventName" class="form-label">Event Name</label>
            <input asp-for="EventName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="EventDate" class="form-label">Event Date</label>
            <input asp-for="EventDate" class="form-control" type="date" required />
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label">Location</label>
            <input asp-for="Location" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Distance" class="form-label">Distance (km)</label>
            <input asp-for="Distance" class="form-control" type="number"
                   step="0.01" required />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>

        <a asp-controller="Events" asp-action="Index"
           class="btn btn-secondary">Cancel</a>
    </form>
</div>