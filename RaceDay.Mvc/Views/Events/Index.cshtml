@model List<RaceDay.Mvc.Models.Event>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold">Manage Events</h1>
            <p class="text-muted">
                View and manage your RaceDay events.
            </p>
        </div>

        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-primary">
            Create New Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var raceEvent in Model)
                    {
                        <tr>
                            <td>@raceEvent.EventName</td>

                            <td>
                                @raceEvent.EventDate.ToString("dd MMM yyyy")
                            </td>

                            <td>@raceEvent.Location</td>

                            <td>@raceEvent.Distance km</td>

                            <td>
                                <div class="d-flex gap-2 flex-wrap">

                                    <a asp-controller="Home"
                                       asp-action="Details"
                                       asp-route-id="@raceEvent.EventID"
                                       class="btn btn-sm btn-info">
                                        View
                                    </a>

                                    <a asp-controller="Events"
                                       asp-action="Edit"
                                       asp-route-id="@raceEvent.EventID"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-controller="Events"
                                       asp-action="Delete"
                                       asp-route-id="@raceEvent.EventID"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                    <a asp-controller="Categories"
                                       asp-action="Index"
                                       asp-route-eventID="@raceEvent.EventID"
                                       class="btn btn-sm btn-success">
                                        Manage Categories
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }

</div>